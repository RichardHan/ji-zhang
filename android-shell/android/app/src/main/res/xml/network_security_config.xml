<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-hosted servers may be reached over HTTP on a LAN (e.g. http://192.168.1.10:8080). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
